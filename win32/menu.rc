#include "resource.h"

Terep2Win32 MENU DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open folder", T2_APP_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",  T2_APP_EXIT
    END
#ifdef DEBUGMENU
    POPUP "&Visualisation"
    BEGIN
        MENUITEM "&Blinkenlights", T2_APP_BLINKEN
    END
    POPUP "&Simulation"
    BEGIN
        MENUITEM "&Running (3)", T2_APP_PHYS_RUN
        MENUITEM "Single ste&p (space)", T2_APP_PHYS_STEP
    END
#endif // DEBUGMENU
    POPUP "&Sound"
    BEGIN
        MENUITEM "&Enable sound", T2_APP_SOUND
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", T2_APP_ABOUT
    END
END
