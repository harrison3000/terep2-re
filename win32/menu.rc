#include "resource.h"

Terep2Win32 MENU DISCARDABLE
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open folder", T2_APP_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",  T2_APP_EXIT
    END
    POPUP "&Graphics"
    BEGIN
        POPUP "&Resolution"
        BEGIN
            MENUITEM "Original",    T2_SCALE_P1
            MENUITEM "Original 2x", T2_SCALE_P2
            MENUITEM SEPARATOR            
            MENUITEM "640x400",  T2_SCALE_S1
            MENUITEM "800x600",  T2_SCALE_S2
            MENUITEM "960x600",  T2_SCALE_S3
            MENUITEM "1280x720", T2_SCALE_S4
            MENUITEM "1440x900", T2_SCALE_S4
        END
    END
    POPUP "&Sound"
    BEGIN
        MENUITEM "&Enable sound", T2_APP_SOUND
    END
    POPUP "&Debug"
    BEGIN
        MENUITEM "&Blinkenlights", T2_APP_BLINKEN
        MENUITEM SEPARATOR
        MENUITEM "&Running\tF7", T2_APP_PHYS_RUN
        MENUITEM "Single-ste&p\tF8", T2_APP_PHYS_STEP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About", T2_APP_ABOUT
    END
END
